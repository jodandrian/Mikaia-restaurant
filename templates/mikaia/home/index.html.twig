{% extends 'base.html.twig' %}

{% block title %}Mikaia — Commande en Ligne & Restaurant{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#1c1411] text-stone-100 font-sans selection:bg-[#9FE855] selection:text-stone-950">
    
    <!-- Navbar Flottante -->
    <nav class="fixed top-0 left-0 w-full z-50 bg-[#1c1411]/90 backdrop-blur-md border-b border-[#2d201c]">
        <div class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between">
            
            <!-- Logo style personnalisé -->
            <a href="#" class="flex flex-col items-start group">
                <div class="flex items-baseline font-serif tracking-tight">
                    <span class="text-3xl font-bold text-[#b87d4b] italic tracking-wider drop-shadow-sm">Mi</span><span class="text-3xl font-bold text-[#9FE855] tracking-wide">kaia</span>
                </div>
                <div class="flex items-center gap-2 w-full">
                    <span class="text-[10px] uppercase tracking-[0.25em] text-[#b87d4b] font-medium pl-0.5">Restaurant</span>
                    <div class="h-[1px] flex-grow bg-gradient-to-r from-[#b87d4b]/60 to-transparent"></div>
                </div>
            </a>
            <!-- <a href="#" class="flex items-center py-2">
                <img src="{{ asset('images/logo-mikaia.png') }}" alt="Mikaia Restaurant" class="h-20 w-auto object-contain">
            </a> -->
          
            <div class="hidden md:flex items-center space-x-8 text-sm font-medium text-stone-300">
                <a href="#menu" class="hover:text-[#9FE855] transition">La Carte</a>
                <a href="#concept" class="hover:text-[#9FE855] transition">Le Concept</a>
                <a href="#suivi" class="hover:text-[#9FE855] transition">Suivre ma commande</a>
            </div>

            <!-- Bouton Panier interactif -->
            <button onclick="togglePanier()" class="relative bg-[#261a15] border border-[#3d2b23] hover:border-[#9FE855]/50 text-stone-200 px-5 py-2.5 rounded-full flex items-center gap-3 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#9FE855]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                <span class="text-sm font-medium">Panier</span>
                <span id="cart-count" class="bg-[#9FE855] text-stone-950 text-xs font-bold px-2 py-0.5 rounded-full">0</span>
            </button>
        </div>
    </nav>

    <!-- Hero Section Commande -->
    <header class="relative min-h-[60vh] flex items-center justify-center bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#2a1d17] via-[#1c1411] to-[#1c1411] px-6 pt-32">
        <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#9FE855_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none"></div>
        
        <div class="relative max-w-4xl mx-auto text-center space-y-6">
            <span class="inline-block py-1.5 px-4 rounded-full bg-[#9FE855]/10 border border-[#9FE855]/25 text-[#9FE855] text-xs tracking-widest uppercase font-semibold">
                L'art de recevoir, la saveur en héritage
            </span>
            <h1 class="text-4xl md:text-6xl font-serif font-bold tracking-tight text-white leading-tight">
                Commandez en ligne <br>et savourez <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#9FE855] to-[#c2f778]">chez vous</span>
            </h1>
            <p class="text-base md:text-lg text-stone-300 max-w-xl mx-auto font-light">
                Choisissez vos plats préférés, personnalisez votre commande et faites-vous livrer ou préparez un à-emporter.
            </p>
        </div>
    </header>

    <!-- Section Principale : Carte & Commande -->
    <main id="menu" class="max-w-7xl mx-auto py-16 px-6 grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        <!-- Liste des Plats (2 colonnes sur grand écran) -->
        <div class="lg:col-span-2 space-y-12">
            <div class="flex justify-between items-center border-b border-[#3d2b23] pb-4">
                <h2 class="text-2xl md:text-3xl font-serif font-bold text-white">Notre Carte</h2>
                <div class="flex gap-2 text-xs">
                    <button class="bg-[#9FE855] text-stone-950 font-semibold px-3 py-1.5 rounded-lg">Tous</button>
                    <button class="bg-[#241914] text-stone-300 hover:text-white px-3 py-1.5 rounded-lg border border-[#3d2b23]">Plats</button>
                    <button class="bg-[#241914] text-stone-300 hover:text-white px-3 py-1.5 rounded-lg border border-[#3d2b23]">Boissons</button>
                </div>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                {% for plat in plats %}
                    <div class="group bg-[#241914]/80 border border-[#3d2b23] rounded-2xl overflow-hidden hover:border-[#9FE855]/50 transition-all duration-300 flex flex-col justify-between shadow-xl">
                        <div class="h-48 bg-gradient-to-br from-[#2f211b] to-[#1c1411] relative flex items-center justify-center">
                            <span class="absolute top-3 right-3 bg-[#1c1411]/90 backdrop-blur-md border border-[#3d2b23] text-[#9FE855] text-xs font-medium px-2.5 py-1 rounded-full">
                                {{ plat.badge }}
                            </span>
                            <span class="text-stone-400 font-serif text-sm">[ Visuel : {{ plat.nom }} ]</span>
                        </div>
                        
                        <div class="p-6 space-y-3 flex-grow flex flex-col justify-between">
                            <div>
                                <div class="text-[10px] uppercase tracking-widest text-[#9FE855] font-semibold">{{ plat.categorie }}</div>
                                <div class="flex justify-between items-baseline mt-1">
                                    <h3 class="text-lg font-serif font-bold text-white group-hover:text-[#9FE855] transition">{{ plat.nom }}</h3>
                                    <span class="text-[#9FE855] font-bold text-base">{{ plat.prix }}</span>
                                </div>
                                <p class="text-stone-300 text-xs leading-relaxed font-light mt-2">{{ plat.desc }}</p>
                            </div>
                            
                            <div class="pt-4 border-t border-[#3d2b23]">
                                <button onclick="ajouterAuPanier('{{ plat.nom }}', '{{ plat.prix }}')" class="w-full bg-[#2f211b] hover:bg-[#9FE855] hover:text-stone-950 text-stone-200 text-sm font-medium py-2.5 rounded-xl transition duration-300 flex items-center justify-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                    </svg>
                                    Ajouter au panier
                                </button>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Panier / Tunnel de commande latéral -->
        <div class="lg:col-span-1">
            <div class="sticky top-28 bg-[#201713] border border-[#3d2b23] rounded-3xl p-6 shadow-2xl space-y-6">
                <div class="flex items-center justify-between border-b border-[#3d2b23] pb-4">
                    <h3 class="text-xl font-serif font-bold text-white flex items-center gap-2">
                        <span>Votre Commande</span>
                    </h3>
                    <span class="text-xs text-stone-400" id="item-count">0 article</span>
                </div>

                <!-- Liste des articles commandés -->
                <div id="cart-items" class="space-y-4 max-h-64 overflow-y-auto pr-1 text-sm text-stone-300">
                    <p class="text-stone-500 text-center py-6 italic text-xs">Votre panier est vide pour le moment.</p>
                </div>

                <!-- Total et Paiement -->
                <div class="border-t border-[#3d2b23] pt-4 space-y-3">
                    <div class="flex justify-between text-stone-400 text-sm">
                        <span>Sous-total</span>
                        <span id="subtotal">0.00 Ar</span>
                    </div>
                    <div class="flex justify-between text-stone-400 text-sm">
                        <span>Frais de livraison</span>
                        <span>5 000 Ar</span>
                    </div>
                    <div class="flex justify-between text-white font-bold text-lg pt-2 border-t border-[#3d2b23]/50">
                        <span>Total</span>
                        <span id="total" class="text-[#9FE855]">5 000 Ar</span>
                    </div>
                </div>

                <form action="#" method="POST" class="space-y-4 pt-2">
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-stone-400 mb-1">Mode de retrait</label>
                        <select class="w-full bg-[#1c1411] border border-[#3d2b23] rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-[#9FE855]">
                            <option>Livraison à domicile</option>
                            <option>À emporter (Click & Collect)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-stone-400 mb-1">Adresse ou Téléphone</label>
                        <input type="text" placeholder="Votre numéro ou adresse..." class="w-full bg-[#1c1411] border border-[#3d2b23] rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-[#9FE855]">
                    </div>
                    <button type="submit" class="w-full bg-[#9FE855] hover:bg-[#8fd649] text-stone-950 font-semibold py-3.5 rounded-xl transition shadow-lg shadow-[#9FE855]/10 text-center block">
                        Valider la commande
                    </button>
                </form>
            </div>
        </div>

    </main>

    <!-- Script minimaliste pour simuler l'ajout au panier -->
    <script>
        let cart = [];

        function ajouterAuPanier(nom, prix) {
            cart.push({ nom, prix: parseFloat(prix.replace(/[^0-9.-]+/g,"")) });
            mettreAJourPanier();
        }

        function mettreAJourPanier() {
            const container = document.getElementById('cart-items');
            const countBadge = document.getElementById('cart-count');
            const itemCount = document.getElementById('item-count');
            const subtotalEl = document.getElementById('subtotal');
            const totalEl = document.getElementById('total');

            countBadge.innerText = cart.length;
            itemCount.innerText = cart.length + (cart.length > 1 ? ' articles' : ' article');

            if (cart.length === 0) {
                container.innerHTML = '<p class="text-stone-500 text-center py-6 italic text-xs">Votre panier est vide pour le moment.</p>';
                subtotalEl.innerText = '0.00 Ar';
                totalEl.innerText = '5 000 Ar';
                return;
            }

            container.innerHTML = '';
            let subtotal = 0;

            cart.forEach((item, index) => {
                subtotal += item.prix;
                container.innerHTML += `
                    <div class="flex justify-between items-center bg-[#1c1411] p-3 rounded-xl border border-[#3d2b23]">
                        <div>
                            <div class="font-medium text-white">${item.nom}</div>
                            <div class="text-xs text-[#9FE855]">${item.prix.toLocaleString()} Ar</div>
                        </div>
                        <button onclick="supprimerDuPanier(${index})" class="text-stone-500 hover:text-red-400 text-xs">✕</button>
                    </div>
                `;
            });

            subtotalEl.innerText = subtotal.toLocaleString() + ' Ar';
            totalEl.innerText = (subtotal + 5000).toLocaleString() + ' Ar';
        }

        function supprimerDuPanier(index) {
            cart.splice(index, 1);
            mettreAJourPanier();
        }
    </script>

    <!-- Footer -->
    <footer class="bg-[#1c1411] border-t border-[#2d201c] py-12 px-6 text-center text-stone-400 text-sm mt-20">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex flex-col items-start">
                <div class="flex items-baseline font-serif">
                    <span class="text-xl font-bold text-[#b87d4b] italic">Mi</span><span class="text-xl font-bold text-[#9FE855]">kaia</span>
                </div>
                <span class="text-[9px] uppercase tracking-[0.2em] text-[#b87d4b]">Restaurant</span>
            </div>
            <p>&copy; 2026 Mikaia Restaurant. Tous droits réservés. L'art de recevoir, la saveur en héritage.</p>
            <div class="flex space-x-6 text-stone-300">
                <a href="#" class="hover:text-[#9FE855] transition">Instagram</a>
                <a href="#" class="hover:text-[#9FE855] transition">Facebook</a>
                <a href="#" class="hover:text-[#9FE855] transition">Contact</a>
            </div>
        </div>
    </footer>
</div>
{% endblock %}