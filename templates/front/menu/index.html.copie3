<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu & Commande — Mikaia Restaurant</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Alpine.js (Bibliothèque réactive ultra-légère) -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-[#110c09] text-stone-200 min-h-screen font-sans flex flex-col" x-data="cartApp()">

    <!-- Header / Navigation -->
    <header class="border-b border-[#3b271c] bg-[#18100a]/90 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-8">
                <div class="flex flex-col">
                    <h1 class="text-2xl font-serif font-bold text-[#8CD62B] tracking-wide">MIKAIA</h1>
                    <span class="text-[10px] text-stone-400 uppercase tracking-widest -mt-1">L'art de recevoir, la saveur en héritage</span>
                </div>
                <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-stone-300">
                    <a href="#carte" class="text-[#8CD62B] transition">La Carte</a>
                    <a href="#" class="hover:text-[#8CD62B] transition">Le Concept</a>
                </nav>
            </div>
            
            <div class="flex items-center gap-4">
                <a href="#" class="text-xs text-stone-400 hover:text-white transition hidden sm:inline-block">Suivre ma commande</a>
                <div class="flex items-center gap-2 bg-[#1c130c] border border-[#3b271c] px-3.5 py-1.5 rounded-full">
                    <span class="text-xs">🛒 Panier</span>
                    <span class="bg-[#8CD62B] text-black text-[10px] font-bold px-2 py-0.5 rounded-full" x-text="totalItems">0</span>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 md:px-6 py-8 flex-1 w-full">

        <!-- Messages Flash Symfony -->
        {% for message in app.flashes('success') %}
            <div class="mb-6 p-4 bg-[#8CD62B]/10 border border-[#8CD62B] text-[#8CD62B] rounded-2xl font-medium text-sm text-center">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="mb-6 p-4 bg-red-500/10 border border-red-500 text-red-400 rounded-2xl font-medium text-sm text-center">
                {{ message }}
            </div>
        {% endfor %}

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- COLONNE GAUCHE : Notre Carte & Plats (8 Colonnes) -->
            <section class="lg:col-span-8 space-y-6">
                
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <h2 class="text-4xl font-serif font-bold text-white tracking-tight">Notre Carte</h2>
                    
                    <!-- Filtres par catégories -->
                    <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
                        <button class="bg-[#8CD62B] text-black font-bold text-xs px-4 py-2 rounded-xl whitespace-nowrap shadow-lg shadow-[#8CD62B]/10">Tous</button>
                        {% for category in categories %}
                            <button class="bg-[#18100a] hover:bg-[#251910] text-stone-300 border border-[#3b271c] text-xs px-4 py-2 rounded-xl whitespace-nowrap transition">
                                {{ category.name }}
                            </button>
                        {% endfor %}
                    </div>
                </div>

                <!-- Grille des plats -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {% for dish in dishes %}
                        <div class="bg-[#18100a] border border-[#3b271c] rounded-3xl overflow-hidden shadow-xl hover:border-[#8CD62B]/40 transition duration-300 flex flex-col justify-between group">
                            <div>
                                <div class="relative overflow-hidden h-48 bg-[#251910]">
                                    {% if dish.imageUrl %}
                                        <img src="{{ dish.imageUrl }}" alt="{{ dish.name }}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                                    {% else %}
                                        <div class="w-full h-full flex items-center justify-center text-stone-600 text-xs uppercase tracking-wider">Image non disponible</div>
                                    {% endif %}
                                    {% if dish.category %}
                                        <span class="absolute top-3 left-3 bg-[#110c09]/80 backdrop-blur-md text-[#8CD62B] text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md border border-[#3b271c]">
                                            {{ dish.category.name }}
                                        </span>
                                    {% endif %}
                                </div>

                                <div class="p-5">
                                    <div class="flex items-start justify-between gap-2 mb-2">
                                        <h3 class="font-serif font-bold text-lg text-white group-hover:text-[#8CD62B] transition">{{ dish.name }}</h3>
                                        <span class="text-[#8CD62B] font-bold text-base whitespace-nowrap">{{ dish.price|number_format(0, '', ' ') }} Ar</span>
                                    </div>
                                    <p class="text-xs text-stone-400 line-clamp-2 leading-relaxed">{{ dish.description }}</p>
                                </div>
                            </div>

                            <div class="p-5 pt-0">
                                <button type="button" 
                                        @click="addItem({{ dish.id }}, '{{ dish.name|escape('js') }}', {{ dish.price }})" 
                                        class="w-full bg-[#251910] hover:bg-[#8CD62B] text-stone-300 hover:text-black font-semibold text-xs py-3 rounded-2xl border border-[#3b271c] hover:border-[#8CD62B] transition duration-200 flex items-center justify-center gap-2">
                                    <span>+</span> Ajouter au panier
                                </button>
                            </div>
                        </div>
                    {% else %}
                        <p class="col-span-2 text-center text-stone-500 py-16 bg-[#18100a] rounded-3xl border border-[#3b271c]">Aucun plat disponible pour le moment.</p>
                    {% endfor %}
                </div>
            </section>

            <!-- COLONNE DROITE : Panier Réactif (4 Colonnes) -->
            <aside class="lg:col-span-4 lg:sticky lg:top-24">
                <div class="bg-[#18100a] border border-[#3b271c] rounded-3xl p-6 shadow-2xl space-y-6">
                    
                    <div class="flex items-center justify-between border-b border-[#2d1e15] pb-4">
                        <h3 class="font-serif font-bold text-xl text-white flex items-center gap-2">
                            <span>🛒</span> Votre Commande
                        </h3>
                        <span class="text-xs text-stone-400" x-text="totalItems + ' article(s)'">0 article</span>
                    </div>

                    <!-- Affichage de la liste du panier Alpine -->
                    <div class="space-y-3 max-h-60 overflow-y-auto pr-1 no-scrollbar">
                        <template x-if="items.length === 0">
                            <p class="text-xs text-stone-500 text-center py-6 italic">Votre panier est vide pour le moment.</p>
                        </template>

                        <template x-for="(item, index) in items" :key="item.id">
                            <div class="flex items-center justify-between bg-[#110c09] p-3 rounded-2xl border border-[#3b271c]">
                                <div class="flex-1 pr-2">
                                    <div class="text-xs font-bold text-white" x-text="item.name"></div>
                                    <div class="text-[11px] text-[#8CD62B] font-medium" x-text="formatMoney(item.price * item.qty) + ' Ar'"></div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <input type="number" min="1" max="20" x-model.number="item.qty" class="w-12 bg-[#18100a] border border-[#3b271c] rounded-lg text-center text-xs py-1 text-white focus:outline-none focus:border-[#8CD62B]">
                                    <button type="button" @click="removeItem(index)" class="text-stone-500 hover:text-red-400 text-xs px-1">✕</button>
                                </div>
                            </div>
                        </template>
                    </div>

                    <!-- Formulaire de soumission vers Symfony -->
                    <form method="post" action="{{ path('app_front_order_place') }}" class="space-y-4 pt-4 border-t border-[#2d1e15]">
                        
                        <!-- Données JSON du panier envoyées à Symfony -->
                        <input type="hidden" name="cart_data" :value="JSON.stringify(items)">

                        <!-- Récapitulatif Prix calculé en direct -->
                        <div class="space-y-2 text-xs text-stone-400">
                            <div class="flex justify-between">
                                <span>Sous-total</span>
                                <span class="text-stone-200 font-medium" x-text="formatMoney(subtotal) + ' Ar'">0 Ar</span>
                            </div>
                            <div class="flex justify-between">
                                <span>Frais de livraison</span>
                                <span class="text-stone-200 font-medium" x-text="formatMoney(deliveryFee) + ' Ar'">0 Ar</span>
                            </div>
                            <div class="flex justify-between text-base font-bold text-white pt-2 border-t border-[#2d1e15]">
                                <span>Total</span>
                                <span class="text-[#8CD62B]" x-text="formatMoney(grandTotal) + ' Ar'">0 Ar</span>
                            </div>
                        </div>

                        <!-- Inputs Client -->
                        <div class="space-y-3 pt-2">
                            <div>
                                <label class="block text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-1">Nom complet du client</label>
                                <input type="text" name="customer_name" placeholder="Ex: Jean Rabe" required class="w-full bg-[#110c09] border border-[#3b271c] rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-[#8CD62B] transition">
                            </div>

                            <div>
                                <label class="block text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-1">Mode de retrait</label>
                                <select name="delivery_mode" x-model="deliveryMode" class="w-full bg-[#110c09] border border-[#3b271c] rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-[#8CD62B] transition">
                                    <option value="sur_place">Sur place (Table)</option>
                                    <option value="emporter">À emporter</option>
                                    <option value="livraison">Livraison à domicile (+5 000 Ar)</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-1">Téléphone & Adresse / Table</label>
                                <input type="text" name="table_number" placeholder="Ex: 034 00 000 00 / Table 4" required class="w-full bg-[#110c09] border border-[#3b271c] rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-[#8CD62B] transition">
                            </div>
                        </div>

                        <button type="submit" :disabled="items.length === 0" class="w-full bg-[#8CD62B] disabled:opacity-40 disabled:cursor-not-allowed text-black font-bold text-xs py-3.5 rounded-xl hover:bg-opacity-90 transition shadow-lg shadow-[#8CD62B]/10">
                            Valider la commande
                        </button>
                    </form>
                </div>
            </aside>
        </div>
    </main>

    <!-- Composant JS Alpine.js -->
    <script>
        function cartApp() {
            return {
                items: [],
                deliveryMode: 'sur_place',

                addItem(id, name, price) {
                    let existing = this.items.find(item => item.id === id);
                    if (existing) {
                        existing.qty++;
                    } else {
                        this.items.push({ id, name, price, qty: 1 });
                    }
                },

                removeItem(index) {
                    this.items.splice(index, 1);
                },

                get totalItems() {
                    return this.items.reduce((sum, item) => sum + item.qty, 0);
                },

                get subtotal() {
                    return this.items.reduce((sum, item) => sum + (item.price * item.qty), 0);
                },

                get deliveryFee() {
                    return (this.deliveryMode === 'livraison' && this.items.length > 0) ? 5000 : 0;
                },

                get grandTotal() {
                    return this.subtotal + this.deliveryFee;
                },

                formatMoney(amount) {
                    return new Intl.NumberFormat('fr-FR').format(amount);
                }
            }
        }
    </script>
</body>
</html>