{% extends 'Front/base.html.twig' %}

{# Titre dynamique de la page d'accueil #}
{% block title %}Mikaia — Commande en Ligne & Restaurant{% endblock %}

{% block body %}
{# 
    1. STYLE LOCAL : MASQUAGE DES BARRES DE DÉFILEMENT
    Utile pour garder un design propre sur mobile lors du défilement horizontal de la barre de filtres.
#}
<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

{# 
    2. RACINE ALPINEJS (x-data)
    'x-data="cartComponent()"' initialise le composant global Alpine.js défini plus bas dans les scripts.
    Toutes les variables (items, customerName, etc.) et méthodes (addItem, submitOrder) sont accessibles 
    dans tout ce bloc DOM.
#}
<div id="home-root" x-data="cartComponent()" data-order-url="{{ path('api_order_create') }}">

    {# ===================================================================================== #}
    {# 1. HERO SECTION & CARROUSEL D'IMAGES                                                  #}
    {# ===================================================================================== #}
    <header id="hero-section" class="relative h-[80vh] sm:h-[85vh] min-h-[500px] flex items-center justify-center overflow-hidden bg-[#110c09]">
        
        {# Slides du carrousel gérées en JavaScript Vanille #}
        <div id="mikaia-carousel" class="absolute inset-0 w-full h-full">
            <div class="carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-100 z-10">
                <img src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=1920&q=80" alt="Grillade Signature" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-[#110c09] via-[#110c09]/60 to-black/70"></div>
            </div>

            <div class="carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0 z-0">
                <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=1920&q=80" alt="Gastronomie Mikaia" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-[#110c09] via-[#110c09]/60 to-black/70"></div>
            </div>

            <div class="carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-0 z-0">
                <img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=1920&q=80" alt="Ambiance Restaurant" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-[#110c09] via-[#110c09]/60 to-black/70"></div>
            </div>
        </div>

        {# Textes et Slogan Signature #}
        <div class="relative z-20 max-w-4xl mx-auto text-center space-y-4 sm:space-y-6 px-4 sm:px-6 pt-20 sm:pt-24">
            <span class="inline-block py-1.5 px-4 sm:px-5 rounded-full bg-[#8CD62B]/20 backdrop-blur-md border border-[#8CD62B]/40 text-[#8CD62B] text-[10px] sm:text-xs tracking-widest uppercase font-semibold shadow-xl">
                L'art de recevoir, la saveur en héritage
            </span>

            <h1 class="text-3xl sm:text-5xl md:text-6xl font-serif font-bold tracking-tight text-white leading-tight drop-shadow-2xl">
                Commandez en ligne <br class="hidden sm:block">et savourez <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8CD62B] to-[#b3f75e]">chez vous</span>
            </h1>

            <p class="text-xs sm:text-base md:text-lg text-stone-200 max-w-xl mx-auto font-light drop-shadow px-2">
                Choisissez vos plats préférés, personnalisez votre commande et faites-vous livrer ou optez pour le retrait en restaurant.
            </p>

            <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="#menu-cart-section" @click.prevent="scrollToSection('menu-cart-section')" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#8CD62B] hover:bg-[#7bc220] text-stone-950 font-bold px-8 py-3.5 rounded-full transition-all duration-300 transform hover:scale-105 shadow-lg shadow-[#8CD62B]/20">
                    <span>Découvrir la Carte</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </a>
            </div>
        </div>

        {# Flèches de navigation du Carrousel #}
        <button id="prevBtn" type="button" aria-label="Précédent" class="flex absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-30 bg-black/40 hover:bg-[#8CD62B] hover:text-stone-950 text-white p-2.5 sm:p-3 rounded-full backdrop-blur-md border border-white/10 transition cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>

        <button id="nextBtn" type="button" aria-label="Suivant" class="flex absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-30 bg-black/40 hover:bg-[#8CD62B] hover:text-stone-950 text-white p-2.5 sm:p-3 rounded-full backdrop-blur-md border border-white/10 transition cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>

        <div id="carouselDots" class="absolute bottom-6 left-1/2 -translate-x-1/2 z-30 flex items-center space-x-2.5">
            <button type="button" data-index="0" class="dot w-2.5 h-2.5 rounded-full bg-[#8CD62B] transition-all cursor-pointer"></button>
            <button type="button" data-index="1" class="dot w-2.5 h-2.5 rounded-full bg-white/40 hover:bg-white transition-all cursor-pointer"></button>
            <button type="button" data-index="2" class="dot w-2.5 h-2.5 rounded-full bg-white/40 hover:bg-white transition-all cursor-pointer"></button>
        </div>
    </header>

    {# ===================================================================================== #}
    {# 2. SECTION PRINCIPALE : CARTE & PANIER DE COMMANDE                                   #}
    {# ===================================================================================== #}
    <main id="menu-cart-section" class="max-w-7xl mx-auto pt-16 pb-12 px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-6 scroll-mt-20">
        
        {# 
            COLONNE GAUCHE (8 Colonnes sur grand écran) : LA CARTE DES PLATS
            'x-data="{ selectedCategory: 'all' }"' gère l'état du filtre actif en local sans recharger la page.
        #}
        <div class="lg:col-span-7 xl:col-span-8 space-y-5" x-data="{ selectedCategory: 'all' }">
            
            <!-- FILTRES DE CATÉGORIES -->
            <div class="border-b border-[#3b271c]/60 pb-3">
                <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
                    {# Bouton "Tous les plats" #}
                    <button type="button" 
                            @click="selectedCategory = 'all'" 
                            :class="selectedCategory === 'all' ? 'bg-[#8CD62B] text-stone-950 font-bold shadow-lg shadow-[#8CD62B]/20' : 'bg-[#18100a] text-stone-300 hover:text-white border border-[#3b271c] hover:border-[#8CD62B]/40'"
                            class="px-4 py-2 rounded-xl text-xs transition-all whitespace-nowrap cursor-pointer">
                        Tous
                    </button>

                    {# Boucle Twig sur les catégories dynamiques envoyées depuis Symfony #}
                    {% for category in categories|default([]) %}
                        {% set catId = category.id ?? loop.index %}
                        {% set catName = category.name ?? category.nomCategory ?? category.nom ?? 'Catégorie' %}
                        
                        <button type="button" 
                                @click="selectedCategory = '{{ catId }}'" 
                                :class="selectedCategory === '{{ catId }}' ? 'bg-[#8CD62B] text-stone-950 font-bold shadow-lg shadow-[#8CD62B]/20' : 'bg-[#18100a] text-stone-300 hover:text-white border border-[#3b271c] hover:border-[#8CD62B]/40'"
                                class="px-4 py-2 rounded-xl text-xs transition-all whitespace-nowrap cursor-pointer">
                            {{ catName }}
                        </button>
                    {% endfor %}
                </div>
            </div>
            
            <!-- GRILLE DES PLATS (3 colonnes réactives) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for dish in dishes|default([]) %}
                    {% set dishCatId = dish.category.id ?? 'all' %}
                    {% set dishCatName = dish.category.name ?? dish.category.nomCategory ?? dish.category.nom ?? 'Spécialité' %}
                    {% set dishId = dish.id ?? loop.index %}
                    {% set dishName = dish.name ?? dish.nom ?? 'Plat Mikaia' %}
                    {% set dishRawPrice = dish.price ?? dish.prix ?? 0 %}
                    {% set dishDesc = dish.description ?? '' %}
                    {% set dishImg = dish.imageUrl ?? dish.image ?? null %}

                    {# 
                        'x-show' : AlpineJS masque/affiche instantanément le plat selon la catégorie sélectionnée.
                    #}
                    <div class="group bg-[#160f0a] border border-[#3b271c]/80 rounded-2xl overflow-hidden hover:border-[#8CD62B]/50 transition-all duration-300 flex flex-col justify-between shadow-xl" 
                         x-show="selectedCategory === 'all' || selectedCategory === '{{ dishCatId }}'" 
                         x-transition>
                        
                        <!-- Image du plat avec filtre dégradé -->
                        <div class="h-36 relative overflow-hidden bg-stone-900">
                            {% if dishImg %}
                                <img src="{{ dishImg starts with 'http' ? dishImg : asset('uploads/images/' ~ dishImg) }}" alt="{{ dishName }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy">
                            {% else %}
                                <img src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80" alt="{{ dishName }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy">
                            {% endif %}
                            <div class="absolute inset-0 bg-gradient-to-t from-[#160f0a] via-transparent to-transparent opacity-80"></div>
                            <span class="absolute top-2.5 left-2.5 bg-[#110c09]/80 backdrop-blur-md text-[#8CD62B] text-[8px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full border border-[#8CD62B]/30">
                                {{ dishCatName }}
                            </span>
                        </div>
                        
                        <!-- Détails du plat -->
                        <div class="p-3.5 space-y-2.5 flex-grow flex flex-col justify-between">
                            <div>
                                <div class="flex flex-col gap-1">
                                    <h3 class="text-sm font-serif font-bold text-white group-hover:text-[#8CD62B] transition line-clamp-1" title="{{ dishName }}">
                                        {{ dishName }}
                                    </h3>
                                    <span class="text-[#8CD62B] font-bold text-xs whitespace-nowrap">
                                        {{ dishRawPrice|number_format(0, ',', ' ') }} Ar
                                    </span>
                                </div>

                                <p class="text-stone-400 text-[11px] leading-relaxed font-light mt-1 line-clamp-2" title="{{ dishDesc }}">
                                    {{ dishDesc }}
                                </p>
                            </div>
                            
                            <!-- Bouton d'ajout rapide au panier via AlpineJS (@click) -->
                            <div class="pt-2 border-t border-[#3b271c]/50">
                                <button type="button"
                                        @click="addItem({{ dishId }}, '{{ dishName|e('js') }}', {{ dishRawPrice|number_format(0, '', '') }})"
                                        class="w-full bg-[#24170e] hover:bg-[#8CD62B] hover:text-stone-950 text-stone-200 text-[11px] font-semibold py-2 rounded-xl transition duration-300 flex items-center justify-center gap-1.5 active:scale-95 cursor-pointer">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                    </svg>
                                    <span>Ajouter</span>
                                </button>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-span-full text-center py-12 text-stone-500 italic text-sm">
                        Aucun plat disponible pour le moment.
                    </div>
                {% endfor %}
            </div>
        </div>

        {# 
            COLONNE DROITE (4 Colonnes sur grand écran) : BLOC PANIER RECTANGLE FIXE
            'sticky top-28' permet au panier de rester visible lors du défilement de la page.
        #}
        <div class="lg:col-span-5 xl:col-span-4">
            <div id="cart-card" class="sticky top-28 bg-[#160f0a] border border-[#3b271c] rounded-2xl p-5 shadow-2xl space-y-4">
                
                <div class="flex items-center justify-between border-b border-[#3b271c]/60 pb-3">
                    <div class="flex items-center gap-2">
                        <span class="text-lg">🛒</span>
                        <h2 class="text-base font-serif font-bold text-white">Votre Commande</h2>
                    </div>
                    <span class="text-xs bg-[#8CD62B]/10 text-[#8CD62B] px-2.5 py-1 rounded-full border border-[#8CD62B]/30 font-semibold"
                          x-text="totalItemsCount() + (totalItemsCount() > 1 ? ' articles' : ' article')">
                    </span>
                </div>
                
                <!-- LISTE DYNAMIQUE DES ARTICLES DANS LE PANIER (AlpineJS x-for) -->
                <div class="space-y-2.5 max-h-56 overflow-y-auto no-scrollbar pr-1">
                    <template x-if="items.length === 0">
                        <div class="text-center py-6">
                            <p class="text-stone-500 text-xs italic">Votre panier est vide pour le moment.</p>
                        </div>
                    </template>

                    <template x-for="item in items" :key="item.id">
                        <div class="flex items-center justify-between bg-[#110c09] p-2.5 rounded-xl border border-[#3b271c]/60 hover:border-[#8CD62B]/30 transition">
                            <div class="flex-1 pr-2">
                                <p class="font-semibold text-white text-xs line-clamp-1" x-text="item.name"></p>
                                <p class="text-[11px] text-[#8CD62B] font-bold" x-text="formatMoney(item.price * item.quantity)"></p>
                            </div>
                            <!-- Contrôles de quantité (+ / -) -->
                            <div class="flex items-center gap-1 bg-[#1b120b] p-1 rounded-lg border border-[#3b271c]">
                                <button type="button" @click="updateQty(item.id, -1)" class="w-5 h-5 bg-[#2a1b10] hover:bg-[#8CD62B] hover:text-black rounded text-xs text-white transition flex items-center justify-center font-bold cursor-pointer">-</button>
                                <span class="text-xs font-bold text-white w-4 text-center" x-text="item.quantity"></span>
                                <button type="button" @click="updateQty(item.id, 1)" class="w-5 h-5 bg-[#2a1b10] hover:bg-[#8CD62B] hover:text-black rounded text-xs text-white transition flex items-center justify-center font-bold cursor-pointer">+</button>
                            </div>
                        </div>
                    </template>
                </div>

                <!-- CALCUL DES TOTAUX EN TEMPS RÉEL -->
                <div class="border-t border-[#3b271c]/60 pt-3 space-y-1.5 text-xs">
                    <div class="flex justify-between text-stone-400">
                        <span>Sous-total</span>
                        <span class="text-stone-200 font-semibold" x-text="formatMoney(subtotal())"></span>
                    </div>
                    <div class="flex justify-between text-stone-400">
                        <span>Frais de livraison</span>
                        <span class="text-stone-200 font-semibold" x-text="formatMoney(deliveryFee())"></span>
                    </div>
                    <div class="flex justify-between text-white font-bold text-base pt-2 border-t border-[#3b271c]/40">
                        <span>Total à payer</span>
                        <span class="text-[#8CD62B]" x-text="formatMoney(total())"></span>
                    </div>
                </div>

                {# 
                    FORMULAIRE DE SOUMISSION AVEC SOUMISSION ASYNCHRONE
                    '@submit.prevent="submitOrder()"' empêche le rechargement de la page et déclenche la fonction JS AJAX.
                    'x-model' lie directement la valeur des inputs HTML aux variables Javascript.
                #}
                <form @submit.prevent="submitOrder()" class="space-y-3 pt-1">
                    <div>
                        <label class="block text-[10px] uppercase tracking-wider text-stone-400 mb-1">Nom complet</label>
                        <input type="text" x-model="customerName" required placeholder="Ex: Jean Rabe" class="w-full bg-[#110c09] border border-[#3b271c] rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#8CD62B] transition">
                    </div>

                    <div>
                        <label class="block text-[10px] uppercase tracking-wider text-stone-400 mb-1">Mode de retrait</label>
                        <select x-model="deliveryMode" class="w-full bg-[#110c09] border border-[#3b271c] rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#8CD62B] transition">
                            <option value="livraison">Livraison à domicile (+5 000 Ar)</option>
                            <option value="emporter">À emporter (Gratuit)</option>
                            <option value="sur_place">Sur place (Table)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-[10px] uppercase tracking-wider text-stone-400 mb-1">Téléphone & Adresse / Table</label>
                        <input type="text" x-model="tableNumber" required placeholder="Ex: 034 00 000 00 / Analakely" class="w-full bg-[#110c09] border border-[#3b271c] rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#8CD62B] transition">
                    </div>

                    <button type="submit" 
                            :disabled="items.length === 0 || isSubmitting"
                            class="w-full bg-[#8CD62B] disabled:opacity-40 disabled:cursor-not-allowed hover:bg-[#7bc220] text-stone-950 font-bold py-3 rounded-xl transition shadow-lg shadow-[#8CD62B]/15 text-xs text-center cursor-pointer flex items-center justify-center gap-2">
                        <span x-show="!isSubmitting">Valider la commande</span>
                        <span x-show="isSubmitting" class="flex items-center gap-2">
                            <svg class="animate-spin h-4 w-4 text-stone-950" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            Envoi en cours...
                        </span>
                    </button>
                </form>
            </div>
        </div>

        <!-- NOTIFICATION TOAST FLOTTANTE -->
        <div class="fixed top-6 right-6 z-50 transform transition-all duration-300 bg-[#8CD62B] text-stone-950 font-bold px-4 py-2.5 rounded-xl shadow-2xl flex items-center gap-2 text-xs pointer-events-none"
             :class="toastShow ? 'translate-y-0 opacity-100' : '-translate-y-32 opacity-0'">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span x-text="toastMessage"></span>
        </div>

    </main>
</div>
{% endblock %}

{% block javascripts %}

    {{ parent() }}

    {# 1. Charger le fichier JS qui contient la déclaration du composant cartComponent #}
    <script src="{{ asset('js/home_cart.js') }}"></script>

    {# 2. Charger Alpine.js en dernier (avec defer) #}
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

{% endblock %}