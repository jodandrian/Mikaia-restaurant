{% extends 'admin/base.html.twig' %}

{% block title %}Edit: {{ dish.name }} — Mikaia Admin{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-serif font-bold text-white">Edit: {{ dish.name }}</h1>
        <a href="{{ path('app_admin_dish_index') }}" class="text-xs text-stone-400 hover:text-white transition">← Cancel and Go Back</a>
    </div>

    <div class="bg-[#18100a] border border-[#3b271c] p-6 rounded-2xl shadow-xl">
        {{ include('admin/dish/_form.html.twig', {'button_label': 'Update Dish Changes'}) }}
    </div>
</div>
{% endblock %}