{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Catégories — Mikaia Admin{% endblock %}

{% block body %}
<div class="space-y-8">
    <!-- Header -->
    <div class="flex justify-between items-end border-b border-[#3b271c] pb-5">
        <div>
            <h1 class="text-3xl font-serif font-bold text-white tracking-wide">Menu Categories</h1>
            <p class="text-xs text-stone-400 mt-1">Organisez vos plats par thématiques attrayantes pour vos clients.</p>
        </div>
        <div class="text-right">
            <span class="text-xs text-stone-500 uppercase tracking-wider font-semibold">Total Catégories</span>
            <div class="text-2xl font-bold text-[#8CD62B]">{{ categories|length }}</div>
        </div>
    </div>

    <!-- Main Content: Grid 2 Columns -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left: Quick Add Form Card -->
        <div class="bg-[#18100a] border border-[#3b271c] rounded-2xl p-6 shadow-2xl h-fit">
            <h2 class="text-lg font-serif font-bold text-white mb-4 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#8CD62B]"></span> Nouvelle Catégorie
            </h2>

            {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
                <div>
                    {{ form_label(form.name, null, {'label_attr': {'class': 'block text-[11px] font-bold text-stone-400 mb-1.5 uppercase tracking-wider'}}) }}
                    {{ form_widget(form.name) }}
                </div>

                <div>
                    {{ form_label(form.icon, null, {'label_attr': {'class': 'block text-[11px] font-bold text-stone-400 mb-1.5 uppercase tracking-wider'}}) }}
                    {{ form_widget(form.icon) }}
                </div>

                <div>
                    {{ form_label(form.description, null, {'label_attr': {'class': 'block text-[11px] font-bold text-stone-400 mb-1.5 uppercase tracking-wider'}}) }}
                    {{ form_widget(form.description) }}
                </div>

                <button type="submit" class="w-full mt-2 bg-[#8CD62B] text-black font-bold text-sm py-3 rounded-xl hover:bg-opacity-90 hover:scale-[1.01] transition transform active:scale-95 shadow-lg shadow-[#8CD62B]/10">
                    + Ajouter la catégorie
                </button>
            {{ form_end(form) }}
        </div>

        <!-- Right: Cards Grid -->
        <div class="lg:col-span-2">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {% for cat in categories %}
                {% set name = cat.name ?? cat.nomCategory ?? 'Sans nom' %}
                <div class="bg-[#18100a] border border-[#3b271c] hover:border-[#8CD62B]/50 rounded-2xl p-5 shadow-xl transition-all duration-300 group flex flex-col justify-between">
                    <div>
                        <!-- Header Card -->
                        <div class="flex justify-between items-start mb-3">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-[#24170f] border border-[#3b271c] flex items-center justify-center text-xl group-hover:scale-110 transition">
                                    {{ cat.icon ?? '🍽️' }}
                                </div>
                                <div>
                                    <h3 class="font-serif font-bold text-white text-base group-hover:text-[#8CD62B] transition">{{ name }}</h3>
                                    <span class="text-[10px] text-stone-500 uppercase font-semibold">
                                        {{ cat.dishes|default([])|length }} Plat(s) associé(s)
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Description -->
                        <p class="text-xs text-stone-400 line-clamp-2 mt-2 leading-relaxed">
                            {{ cat.description ?? 'Aucune description saisie pour cette catégorie.' }}
                        </p>
                    </div>

                    <!-- Actions -->
                    <div class="mt-6 pt-3 border-t border-[#3b271c]/60 flex justify-end items-center gap-3">
                        <a href="{{ path('app_admin_category_edit', {'id': cat.id}) }}" class="text-xs font-semibold text-amber-400 hover:text-amber-300 transition">
                            Éditer
                        </a>

                        <form method="post" action="{{ path('app_admin_category_delete', {'id': cat.id}) }}" class="inline" onsubmit="return confirm('Voulez-vous supprimer cette catégorie ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cat.id) }}">
                            <button class="text-xs font-semibold text-red-400 hover:text-red-300 transition">
                                Supprimer
                            </button>
                        </form>
                    </div>
                </div>
                {% else %}
                <div class="col-span-2 bg-[#18100a] border border-[#3b271c] rounded-2xl p-12 text-center text-stone-500">
                    <p class="text-sm">Aucune catégorie créée pour le moment.</p>
                </div>
                {% endfor %}
            </div>
        </div>

    </div>
</div>
{% endblock %}